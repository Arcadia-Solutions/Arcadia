{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                p.id,\n                p.content,\n                p.created_at,\n                p.updated_at,\n                p.sticky,\n                p.locked,\n                p.forum_thread_id,\n                ROW(u.id, u.username, u.class_name, u.banned, u.avatar, u.warned, u.custom_title) AS \"created_by!: UserLiteAvatar\",\n                t.name AS thread_name,\n                s.id AS sub_category_id,\n                s.name AS sub_category_name,\n                c.id AS category_id,\n                c.name AS category_name\n            FROM forum_posts p\n            JOIN users u ON u.id = p.created_by_id\n            JOIN forum_threads t ON t.id = p.forum_thread_id\n            JOIN forum_sub_categories s ON s.id = t.forum_sub_category_id\n            JOIN forum_categories c ON c.id = s.forum_category_id\n\n            WHERE p.created_by_id = $1\n\n            ORDER BY p.created_at DESC\n\n            LIMIT $2 OFFSET $3;\n            ",
