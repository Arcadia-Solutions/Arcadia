  "query": "\n            SELECT\n                agent,\n                COUNT(DISTINCT user_id)::BIGINT AS count\n            FROM peers\n            WHERE created_at < ($2::DATE + INTERVAL '1 day')\n              AND updated_at >= $1::DATE\n            GROUP BY agent\n            ORDER BY count DESC\n            ",
