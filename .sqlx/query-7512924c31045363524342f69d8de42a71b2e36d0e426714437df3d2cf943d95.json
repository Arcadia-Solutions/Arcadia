  "query": "\n            SELECT\n                tr.filled_by_user_id,\n                tr.filled_by_torrent_id,\n                tr.filled_at,\n                t.created_by_id AS \"torrent_uploader_id?\"\n            FROM torrent_requests tr\n            LEFT JOIN torrents t ON t.id = tr.filled_by_torrent_id\n            WHERE tr.id = $1\n            FOR UPDATE OF tr\n            ",
