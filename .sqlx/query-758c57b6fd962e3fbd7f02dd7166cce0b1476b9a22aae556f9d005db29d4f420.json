{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT a.id, a.name, a.aliases, a.pictures\n                FROM subscriptions_artist_title_groups s\n                JOIN artists a ON a.id = s.artist_id\n                WHERE s.user_id = $1\n                ORDER BY\n                    CASE WHEN $4 = 'asc' THEN s.created_at END ASC,\n                    CASE WHEN $4 = 'desc' THEN s.created_at END DESC\n                LIMIT $2 OFFSET $3\n            ",
