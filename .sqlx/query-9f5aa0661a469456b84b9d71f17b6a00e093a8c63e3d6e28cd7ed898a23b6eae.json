{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT c.id, c.name, c.cover\n                FROM subscriptions_collages s\n                JOIN collage c ON c.id = s.collage_id\n                WHERE s.user_id = $1\n                ORDER BY\n                    CASE WHEN $4 = 'asc' THEN s.created_at END ASC,\n                    CASE WHEN $4 = 'desc' THEN s.created_at END DESC\n                LIMIT $2 OFFSET $3\n            ",
