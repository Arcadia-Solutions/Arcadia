  "query": "\n                SELECT\n                    usn.id, usn.user_id, usn.created_at, usn.content,\n                    u.id AS author_id, u.username AS author_username\n                FROM user_staff_notes usn\n                JOIN users u ON u.id = usn.created_by_id\n                WHERE usn.id = $1\n            ",
