# ==============================================================================
# Arcadia Production Caddyfile Example
# ==============================================================================
# Copy this file to Caddyfile at the repository root:
#   cp Caddyfile.example Caddyfile
#
# Replace example.com with your actual domain or use environment variables.
# Caddy automatically provisions and renews Let's Encrypt TLS certificates.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Main Arcadia Website (Web UI, API, IRC Webchat & WebSocket)
# ------------------------------------------------------------------------------
# Ensure api.reverse_proxy_client_ip_header_name: X-Forwarded-For is set in
# config.yml, so the backend records the ip address of the users.
# ------------------------------------------------------------------------------
arcadia.example.com {
    encode zstd gzip

    # Backend REST API
    handle /api* {
        reverse_proxy backend:8080 {
            header_up X-Forwarded-For {remote_host}
        }
    }

    # KiwiIRC Web Client (static assets)
    redir /kiwiirc /kiwiirc/
    handle_path /kiwiirc/* {
        root * /srv/kiwiirc
        try_files {path} {path}/ /index.html =404
        file_server
    }

    # Ergo IRC WebSocket bridge for KiwiIRC and web clients
    handle_path /webirc/websocket* {
        reverse_proxy ergo:8097
    }

    # Elysia image host (profile `images`): its web UI is built into /srv/elysia by
    # frontend/Dockerfile. Same routing as elysia/frontend/Caddyfile.
    redir /elysia /elysia/
    handle_path /elysia/* {
        @backend path_regexp ^/(api|api-docs|swagger-ui|t)/|^/i/[^/]+\.[^/]+$
        handle @backend {
            reverse_proxy elysia:8090
        }
        handle {
            root * /srv/elysia
            try_files {path} /index.html
            file_server
        }
    }

    # Arcadia Vue SPA (Frontend static files and client-side router fallback)
    handle {
        root * /srv/arcadia
        try_files {path} /index.html
        file_server
    }
}

# ------------------------------------------------------------------------------
# 2. BitTorrent Tracker (Dedicated Subdomain - Recommended)
# ------------------------------------------------------------------------------
# Announce URL: https://tracker.example.com/announce/<passkey>
# Ensure tracker.url in config.yml matches this public tracker URL, and that
# tracker.reverse_proxy_client_ip_header_name: X-Forwarded-For is set.
# ------------------------------------------------------------------------------
tracker.example.com {
    encode zstd gzip

    # the /api routes are only meant for the backend, reaching the tracker through the docker network
    respond /api* 404

    reverse_proxy tracker:8081 {
        header_up X-Forwarded-For {remote_host}
    }
}

# ------------------------------------------------------------------------------
# 3. Chevereto Image Host (Deprecated - enabled with --profile chevereto or full)
# ------------------------------------------------------------------------------
# Elysia, which replaces it, is served under https://arcadia.example.com/elysia/
# (see the main block above). Uncomment to serve Chevereto on images.example.com.
# ------------------------------------------------------------------------------
# images.example.com {
#     encode zstd gzip
#
#     # Allow larger image uploads
#     request_body {
#         max_size 50MB
#     }
#
#     reverse_proxy chevereto_php:80 {
#         header_up Host {upstream_hostport}
#         header_up X-Forwarded-Proto https
#     }
# }

# ------------------------------------------------------------------------------
# 4. Grafana & Telemetry Dashboard (Optional - enabled with --profile telemetry)
# ------------------------------------------------------------------------------
# Monitoring UI: https://grafana.example.com/
# Credentials: admin / $GF_SECURITY_ADMIN_PASSWORD
# ------------------------------------------------------------------------------
grafana.example.com {
    encode zstd gzip

    # Optional: Restrict dashboard access to specific management IPs/subnets:
    # @allowed remote_ip 192.168.1.0/24 203.0.113.50
    # handle @allowed {
    #     reverse_proxy otel-lgtm:3000
    # }
    # respond 403

    reverse_proxy otel-lgtm:3000
}
