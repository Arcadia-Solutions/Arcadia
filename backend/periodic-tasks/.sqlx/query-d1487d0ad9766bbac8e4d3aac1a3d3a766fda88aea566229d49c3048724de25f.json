{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                fp.id,\n                fp.content,\n                fp.created_at,\n                fp.updated_at,\n                fp.sticky,\n                fp.locked,\n                fp.forum_thread_id,\n                ROW(u.id, u.username, u.class_name, u.banned, u.avatar, u.warned, u.custom_title) AS \"created_by!: UserLiteAvatar\"\n            FROM forum_posts fp\n            JOIN users u ON fp.created_by_id = u.id\n            WHERE fp.forum_thread_id = $1\n            ORDER BY fp.created_at ASC\n            OFFSET $2\n            LIMIT $3\n            ",
