  "query": "\n            UPDATE users\n            SET banned = false\n            WHERE banned = true\n            AND id IN (\n                SELECT user_id FROM user_warnings\n                WHERE ban = true AND removed_at IS NULL\n                GROUP BY user_id\n                HAVING COUNT(*) FILTER (WHERE expires_at IS NULL OR expires_at > NOW()) = 0\n            )\n            RETURNING id, passkey, max_snatches_per_day\n            ",
