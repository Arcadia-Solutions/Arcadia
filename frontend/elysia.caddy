# Elysia image host (profile `images`): its web UI is built into /srv/elysia by frontend/Dockerfile.
# Imported by frontend/Caddyfile and Caddyfile.example. Same routing as elysia/frontend/Caddyfile.
redir /elysia /elysia/
handle_path /elysia/* {
	@backend path_regexp ^/(api|api-docs|swagger-ui|m|t)/|^/i/[^/]+\.[^/]+$
	handle @backend {
		reverse_proxy elysia_backend:8090
	}
	handle {
		root * /srv/elysia
		try_files {path} /index.html
		file_server
	}
}
