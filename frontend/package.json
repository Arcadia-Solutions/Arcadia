{
  "name": "arcadia-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore --ignore-pattern '**/api-schema/**'",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/",
    "check-format": "prettier --check src",
    "kiwi:setup": "docker build --target kiwi-true -t arcadia-kiwi-builder -f Dockerfile .. && docker run --rm -v $(pwd)/../kiwiirc/dist:/out arcadia-kiwi-builder cp -r /kiwi/dist/. /out/",
    "gen:api": "openapi-generator-cli generate -g typescript-axios -i ${OPENAPI_SPEC:-http://127.0.0.1:8080/swagger-json/openapi.json} -o ./src/services/api-schema -t .openapi-generator/templates --config .openapi-generator/openapi-generator.config.json --global-property=apiDocs=false,modelDocs=false,skipFormModel=false"
  },
  "dependencies": {
    "@bbob/html": "^4.4.1",
    "@bbob/preset-html5": "^4.4.1",
    "@openapitools/openapi-generator-cli": "^2.25.2",
    "@primeuix/themes": "^1.0.3",
    "@primevue/forms": "^4.5.5",
    "axios": "^1.8.3",
    "diff": "^8.0.2",
    "dompurify": "^3.2.4",
    "highcharts": "^12.5.0",
    "highcharts-vue": "^2.0.1",
    "lodash-es": "^4.17.21",
    "pinia": "^3.0.1",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.13",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/debug": "^4.1.12",
    "@types/diff": "^7.0.2",
    "@types/jsdom": "^21.1.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/runtime-dom": "^3.5.13",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.21.0",
    "eslint-plugin-oxlint": "^0.15.13",
    "eslint-plugin-playwright": "^2.2.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.4.2",
    "jsdom": "^26.0.0",
    "npm-run-all2": "^7.0.2",
    "openapi-typescript": "^7.6.1",
    "oxlint": "^0.15.13",
    "prettier": "3.5.3",
    "sass-embedded": "^1.85.1",
    "sirv": "^3.0.0",
    "typescript": "~5.9.3",
    "vite": "^6.2.1",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vitest": "^4.1.12",
    "vue-tsc": "^2.2.8",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.3"
  }
}
